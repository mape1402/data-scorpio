<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DataScorpio.Testing.Sqlite</PackageId>
    <Title>DataScorpio Testing SQLite</Title>
    <Description>SQLite-backed testing helpers for DataScorpio query profiles and provider translation behavior using EF Core SQLite.</Description>
    <PackageTags>query;filtering;sorting;paging;search;iqueryable;sieve;testing;sqlite;efcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.5" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="..\DataScorpio.Testing\DataScorpio.Testing.csproj" />
  </ItemGroup>
</Project>
