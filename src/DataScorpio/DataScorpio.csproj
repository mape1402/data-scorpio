<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DataScorpio</PackageId>
    <Title>DataScorpio</Title>
    <Description>Typed query engine for safe filtering, sorting, search, paging, validation, JSON descriptors, and Sieve-compatible query strings over IQueryable.</Description>
    <PackageTags>query;filtering;sorting;paging;search;iqueryable;sieve;json;validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
